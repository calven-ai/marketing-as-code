# Copy to .env and fill in only the keys for tools you actually use.
# .env is gitignored — never commit real values. Team sharing: see
# docs/secrets.md (1Password CLI references beat pasting keys in Slack).
#
# Note: Asana, monday.com, HubSpot, and Apify connect via OAuth MCP servers
# and need NO keys here — you authorize in the browser.

# DataForSEO (https://app.dataforseo.com/api-access) — SEO/keyword pulls
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# PostHog — web/product analytics
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com

# Google Analytics 4 — path to a service-account JSON (keep the file itself
# outside the repo or rely on .gitignore's service-account*.json rule)
GOOGLE_APPLICATION_CREDENTIALS=

# Granola — meeting transcript pulls (scripts/pull_transcripts.py)
GRANOLA_API_KEY=

# Slack — the team's own bot app (integrations/slack/). One bot token; the
# channel IDs are not secrets but live here so scripts find them. The
# leadership channel receives red flags from processed transcripts.
SLACK_BOT_TOKEN=
SLACK_REQUESTS_CHANNEL_ID=
SLACK_TEAM_CHANNEL_ID=
SLACK_LEADERSHIP_CHANNEL_ID=
