        "notes"
      ]
    }
  },
  "binaries": {
    "_doc": "Plain text first (AGENTS.md rule 4). brand/ is the one sanctioned binary zone; playgrounds/ is tolerated with a warning.",
    "allowed_dirs": [
      "brand/"
    ],
    "tolerated_dirs": [
      "playgrounds/"
    ],
    "extensions": [
      "png",
      "jpg",
      "jpeg",
      "gif",
      "webp",
      "ico",
      "pdf",
      "psd",
      "ai",
      "sketch",
      "fig",
      "key",
      "pptx",
      "docx",
      "xlsx",
      "zip",
      "gz",
      "tar",
      "mp4",
      "mov",
      "mp3",
      "wav",
      "woff",
      "woff2",
      "ttf",
      "otf",
      "bin",
      "exe",
      "dmg"
    ],
    "max_file_kb": 5120
  },
  "secrets": {
    "_doc": "Shapes of real credentials. Prose may mention a prefix; a match needs the long tail.",
    "patterns": [
      "sk-ant-[A-Za-z0-9_-]{16,}",
      "sk-[A-Za-z0-9_-]{20,}",
      "sk_(?:live|test)_[A-Za-z0-9]{16,}",
      "xox[abprs]-[A-Za-z0-9-]{16,}",
      "ghp_[A-Za-z0-9]{30,}",
      "github_pat_[A-Za-z0-9_]{40,}",
      "gho_[A-Za-z0-9]{30,}",
      "AKIA[0-9A-Z]{16}",
      "AIza[0-9A-Za-z_-]{30,}",
      "-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----",
      "(?i)(?:api[_-]?key|secret|token|password)\\s*[:=]\\s*[\"']?(?!\\$\\{)(?!<)(?![A-Z_]{4,}[\"']?\\s*$)[A-Za-z0-9_\\-]{24,}"
    ]
  },
  "pii": {
    "dirs": [
      "data/",
      "memory/"
    ],
    "email": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
    "allow_domains": [
      "example.com",
      "example.org",
      "users.noreply.github.com"
    ]
  },
  "mcp": {
    "files": [
      ".mcp.json",
      ".cursor/mcp.json"
    ],
    "placeholder": "\\$\\{(?:env:)?([A-Z][A-Z0-9_]*)\\}",
    "env_registry": "integrations/README.md"
  },
  "bookkeeping": {
    "_doc": "A proposal that touches only these paths is bookkeeping: agents maintain them, and the gate on main (gate.yml) merges the proposal itself once the checks are green (docs/workflow.md).",
    "globs": [
      "projects/*/status.md",
      "projects/*/*/status.md",
      "memory/decision-log.md",
      "data/*/snapshots/*",
      "memory/transcripts/inbox/*",
      "memory/transcripts/processed/*",
      "reports/recurring/*/*"
    ],
    "_never": "A proposal that touches any of these paths is never bookkeeping, whatever the globs say: they are the machinery that decides what bookkeeping is. scripts/lint.py carries the same list hard-coded, so editing this file cannot widen it.",
    "never": [
      ".github/**",
      "scripts/**",
      "docs/schema.json",
      ".claude/**",
      ".mcp.json",
      ".cursor/**",
      ".agents/**",
      "integrations/**",
      "AGENTS.md",
      "CLAUDE.md",
      ".gitignore"
    ]
  },
  "settings": {
    "_doc": "The deny rules .claude/settings.json must carry (docs/secrets.md says what each one stops), and the two permission modes it switches off: bypass (no checks at all) and auto (a classifier instead of a person). lint --fix restores a missing one.",
    "file": ".claude/settings.json",
    "required_deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./.git/**)",
      "Read(//proc/**)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(/usr/bin/env*)",
      "Bash(printenv*)",
      "Bash(export)",
      "Bash(export -p*)",
      "Bash(declare -p*)",
      "Bash(set)",
      "Bash(sh -c *)",
      "Bash(bash -c *)",
      "Bash(zsh -c *)",
      "Bash(python3 -c *)",
      "Bash(python -c *)",
      "Bash(node -e *)",
      "Bash(node -p *)",
      "Bash(grep * .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh secret *)",
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --force*)"
    ],
    "disable_bypass": true,
    "disable_auto": true
  },
  "generated": {
