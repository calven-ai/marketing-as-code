{
  "id": "tasks",
  "title": "Tasks",
  "for": "the team's task tool: filing follow-ups per integrations/tasks.md",
  "data_domain": null,
  "manual": {
    "export": "file the task as a `- [ ]` line with the owner in parentheses under `## Tasks` in the project's status.md, or on the follow-ups line of the decision in memory/decision-log.md when it belongs to no project (the fallback in integrations/tasks.md)",
    "drop": "projects/<name>/status.md (the ## Tasks checklist)"
  },
  "bridges": ["generic"],
  "vendors": [
    {
      "id": "linear",
      "name": "Linear",
      "source": "linear",
      "verified": "listing",
      "checked": "2026-09-04",
      "source_url": "https://linear.app/docs/mcp",
      "capabilities": ["issues", "projects", "comments", "cycles", "documents"],
      "writes": true,
      "write_tools": ["create_issue", "update_issue", "create_comment", "create_project", "update_project"],
      "read_only_switch": {"kind": "url", "name": "path", "value": "/mcp/readonly"},
      "caveats": [
        "in the Claude connectors directory",
        "write tool names taken from Linear's published tool list; confirm them in the session's tool list before writing deny rules",
        "the read-only endpoint (`/mcp/readonly`) or the `read` OAuth scope gives a server with no write tools at all; prefer it for anything that only reads",
        "endpoint seen in a secondary listing; confirm on linear.app/docs/mcp on the day you wire it"
      ],
      "routes": {
        "mcp": [
          {
            "id": "oauth",
            "default": true,
            "server": "linear",
            "transport": "http",
            "url": "https://mcp.linear.app/mcp",
            "headers": {},
            "auth": {"model": "oauth", "env": [], "where": "browser grant on first use (OAuth 2.1 with dynamic client registration)"},
            "headless": false,
            "oauth_scopes": []
          },
          {
            "id": "readonly",
            "default": false,
            "server": "linear-readonly",
            "transport": "http",
            "url": "https://mcp.linear.app/mcp/readonly",
            "headers": {},
            "auth": {"model": "oauth", "env": [], "where": "browser grant on first use"},
            "headless": false,
            "oauth_scopes": []
          },
          {
            "id": "token",
            "default": false,
            "server": "linear-token",
            "transport": "http",
            "url": "https://mcp.linear.app/mcp",
            "headers": {"Authorization": "Bearer ${LINEAR_API_KEY}"},
            "auth": {"model": "bearer", "env": ["LINEAR_API_KEY"], "where": "Linear > Settings > Security & access > Personal API keys"},
            "headless": true,
            "oauth_scopes": []
          }
        ],
        "cli": null,
        "script": null
      }
    },
