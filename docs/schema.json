  "frontmatter": {
    "_doc": "Per file glob: required keys, optional keys, enums, ISO-date keys, defaults --fix may add. Keys not in required+optional are warned as unknown.",
    "content/*/draft.md": {
      "required": [
        "project",
        "status",
        "channel",
        "owner",
        "published",
        "published_url"
      ],
      "optional": [],
      "enums": {
        "status": [
          "idea",
          "brief",
          "draft",
          "in-review",
          "published",
          "evergreen"
        ],
        "channel": [
          "blog",
          "email",
          "linkedin",
          "webinar",
          "ad",
          "case-study",
          "web",
          "social",
          "outbound",
          "sales",
          "pr",
          "talk",
          "partner",
          "community",
          "analyst",
          "other"
        ]
      },
      "dates": [
        "published"
      ],
      "defaults": {
        "published": "",
        "published_url": "",
        "project": "",
        "owner": ""
      }
    },
    "strategy/*.md": {
      "except": [
        "strategy/README.md"
      ],
      "required": [
        "document",
        "source",
        "last_reviewed",
        "owner"
      ],
      "optional": [],
      "enums": {
        "source": [
          "repo",
          "context-layer"
        ]
      },
      "dates": [
        "last_reviewed"
      ],
      "defaults": {}
    },
    "strategy/competitive/*.md": {
      "except": [
        "strategy/competitive/README.md",
        "strategy/competitive/_battlecard-template.md"
      ],
      "required": [
        "last_reviewed",
        "owner"
      ],
      "optional": [
        "source",
        "document"
      ],
      "enums": {},
      "dates": [
        "last_reviewed"
      ],
      "defaults": {}
    },
    "brand/voice.md": {
      "required": [
        "source",
        "last_reviewed",
        "owner"
      ],
      "optional": [
        "document"
      ],
      "enums": {
        "source": [
          "repo",
          "context-layer"
        ]
      },
      "dates": [
        "last_reviewed"
      ],
      "defaults": {}
    },
    "brand/visual-identity.md": {
      "required": [
        "source",
        "last_reviewed",
        "owner"
      ],
      "optional": [
        "document"
      ],
      "enums": {
        "source": [
          "repo",
          "context-layer"
        ]
      },
      "dates": [
        "last_reviewed"
      ],
      "defaults": {}
    },
    "memory/transcripts/*/*.md": {
      "except": [
        "memory/transcripts/inbox/README.md",
        "memory/transcripts/processed/README.md"
      ],
      "required": [
        "title",
        "date",
        "source"
      ],
      "optional": [
        "attendees",
        "*_id"
      ],
      "enums": {},
      "dates": [
        "date"
      ],
      "defaults": {}
    },
    ".agents/skills/*/SKILL.md": {
      "required": [
        "name",
        "description"
      ],
      "optional": [
        "metadata",
        "license",
        "compatibility",
        "allowed-tools",
        "disallowed-tools",
        "disable-model-invocation",
        "model",
        "context"
      ],
      "enums": {},
      "dates": [],
      "defaults": {}
    }
  },
  "naming": {
    "_doc": "Regexes over the file or folder name only. Each mirrors the sentence in the folder README that explains it.",
    "content_folder": "^\\d{4}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
    "snapshot": "^(\\d{4}-\\d{2}-\\d{2})-([a-z0-9]+)-([a-z0-9]+(?:-[a-z0-9]+)*)\\.csv$",
    "transcript": "^(\\d{4}-\\d{2}-\\d{2})-[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:md|txt|vtt)$",
    "report_recurring": "^\\d{4}-\\d{2}-\\d{2}(?:-[a-z0-9-]+)?\\.(?:md|html)$",
    "report_adhoc": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
    "report_qmr": "^\\d{4}-q[1-4]$",
    "decision_heading": "^## (\\d{4}-\\d{2}-\\d{2}): \\S.*$",
    "status_heading": "^## (\\d{4}-\\d{2}-\\d{2})$",
    "skill_name": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "decision_log": {
    "bullets": [
      "Decided by",
      "Source",
      "Context",
      "Follow-ups"
    ]
  },
  "project_status": {
    "states": [
      "on track",
      "at risk",
      "blocked",
      "done"
    ],
    "forbidden_files": [
      "draft.md",
      "*.csv",
      "*.html",
      "*.xlsx",
      "*.pptx",
      "*.key"
    ]
  },
  "content": {
    "_doc": "The content template's own placeholders (content/_template/draft.md). Any of these left in a piece past status brief is an error; other [Bracketed] text only warns, because it may be prose.",
    "template_placeholders": [
      "[Title]",
      "[The draft."
    ]
  },
  "reports": {
    "_doc": "QMR status values (reports/_templates/qmr/report.md, reports/README.md), and the strings that mean a dashboard still holds the template's example numbers (reports/_templates/dashboard.html).",
    "qmr_states": [
      "assembling",
      "ready for review",
      "final"
    ],
    "dashboard_sentinels": [
      "data-example=\"replace\"",
      "[Dashboard title]"
    ]
  },
  "adoption": {
    "_doc": "Marks of the template's maintainer and its example data that an adopting team replaces (docs/make-it-yours.md). scripts/lint.py reports each one as info; scripts/doctor.py lists them under Make it yours.",
    "markers": [
      {
        "file": ".github/CODEOWNERS",
        "text": "@owner-placeholder",
        "what": "replace @owner-placeholder in .github/CODEOWNERS with your reviewers' GitHub handles"
      },
      {
        "file": "SECURITY.md",
        "text": "calven-ai/marketing-as-code",
        "what": "SECURITY.md still points at the template's security inbox"
      },
      {
        "file": "CODE_OF_CONDUCT.md",
        "text": "oss@calven.ai",
        "what": "CODE_OF_CONDUCT.md still names the template's contact address"
      },
      {
        "file": "memory/decision-log.md",
        "text": "(repository maintainer)",
        "what": "memory/decision-log.md still holds the template maintainer's decisions"
      },
      {
        "file": "CHANGELOG.md",
        "text": "The first public release, as a GitHub template repository.",
        "what": "CHANGELOG.md is the template's own history; delete it together with docs/roadmap.md, or empty it"
      },
      {
        "file": "docs/roadmap.md",
        "text": "The stance: the maintainers ship",
        "what": "docs/roadmap.md is the template's own plan; delete it together with CHANGELOG.md, or empty it"
      }
    ],
    "example_rows": "example row:",
    "examples_dir": "examples/"
  },
  "catalog": {
    "_doc": "The integration catalog: one JSON file per category under dir, each listing the vendors a team can wire (integrations/catalog/README.md is rendered from them). wired binds a category to the vendor this repo uses. Skills name categories, never vendors, in metadata.needs. bridge_only categories stand in for others and are never a need.",
    "dir": "integrations/catalog",
    "wired": "integrations/wired.json",
    "categories": [
      "crm",
      "marketing-automation",
      "transcripts",
      "web-analytics",
      "seo-data",
      "ai-visibility",
      "ads",
      "social",
      "cms",
      "enrichment",
      "intent",
      "outbound",
      "design",
      "docs",
      "tasks",
      "chat",
      "events",
      "surveys-reviews",
      "pr-media",
      "scraping-search",
      "warehouse-bi",
      "billing",
      "community",
      "context-layer",
      "generic"
    ],
    "bridge_only": [
      "generic"
    ],
    "verified": [
      "vendor",
      "listing",
      "unverified"
    ],
    "stale_after_days": 180,
    "pinned_commands": [
      "npx",
      "uvx",
      "pipx"
    ],
    "source_token": "^[a-z0-9]+$",
    "route_kinds": [
      "mcp",
      "cli",
      "script",
      "manual"
    ]
  },
  "skills": {
    "_doc": "What a skill's metadata may say (docs/skill-authoring.md). areas group the roster in agents/README.md, in this order; needs and optional hold category ids from catalog.categories; roles carry a cadence; writes: external means the skill stages things in outside tools and never runs unattended.",
    "areas": [
      ["core", "Core"],
      ["product-marketing", "Product marketing"],
      ["content", "Content"],
      ["seo", "Organic search"],
      ["aeo", "AI visibility"],
      ["social", "Social"],
      ["paid", "Demand generation and paid"],
      ["email", "Email and lifecycle"],
      ["pipeline", "Pipeline and ABM"],
      ["events", "Events and webinars"],
      ["pr", "PR and analyst relations"],
      ["partner", "Partner marketing"],
      ["community", "Community"],
      ["customer", "Customer marketing"],
      ["ops", "Marketing operations"],
      ["web", "Web"],
      ["brand", "Brand"],
      ["leadership", "Leadership and planning"]
    ],
    "kinds": [
      "role",
      "workflow"
    ],
    "cadence": [
      "daily",
      "weekly",
      "monthly",
      "quarterly",
      "on-demand"
    ],
    "writes": [
      "repo",
      "external"
    ],
    "runs": [
      "person",
      "either"
    ],
    "metadata_keys": [
      "kind",
      "area",
      "needs",
      "optional",
      "cadence",
      "writes",
      "runs"
    ],
    "_budget": "Every description loads into every session. Claude Code lists skills under a character budget and drops descriptions past it; on 2026-09-06 a 200k-context session overflowed at about 20,000 characters of names plus descriptions. The check warns above this total for descriptions alone.",
    "description_budget": 19000
  },
  "csv": {
    "_doc": "Canonical tables: the header row must be exactly this. Snapshots only need a header and uniform columns.",
    "canonical": {
